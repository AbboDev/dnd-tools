{
  "json.schemaDownload.enable": true,
  "json.schemas": [
    {
      "fileMatch": [
        "src/**/*.json"
      ],
      "url": "./schema/homebrew.schema.json"
    },
    {
      "fileMatch": [
        "src/**/_meta.json"
      ],
      "url": "https://raw.githubusercontent.com/TheGiddyLimit/5etools-utils/master/schema/brew-fast/homebrew.json#/$defs/_meta/properties/sources/items"
    },
    {
      "fileMatch": [
        "src/**/bestiary/*.json"
      ],
      "url": "./schema/bestiary.schema.json"
    },
    {
      "fileMatch": [
        "src/**/baseitem/*.json"
      ],
      "url": "./schema/baseitem.schema.json"
    },
    {
      "fileMatch": [
        "src/**/item/*.json"
      ],
      "url": "./schema/item.schema.json"
    },
    {
      "fileMatch": [
        "src/**/spell/*.json"
      ],
      "url": "./schema/spell.schema.json"
    },
    {
      "fileMatch": [
        "builds/*.json"
      ],
      "url": "https://raw.githubusercontent.com/TheGiddyLimit/5etools-utils/master/schema/brew-fast/homebrew.json"
    }
  ],
  "workbench.colorCustomizations": {
    "activityBar.background": "#580D3B",
    "titleBar.activeBackground": "#7B1252",
    "titleBar.activeForeground": "#FFFCFD",
    "titleBar.inactiveBackground": "#580D3B",
    "titleBar.inactiveForeground": "#FFFCFD",
    "statusBar.background": "#580D3B",
    "statusBar.foreground": "#FFFCFD",
    "statusBar.debuggingBackground": "#580D3B",
    "statusBar.debuggingForeground": "#FFFCFD",
    "statusBar.noFolderBackground": "#580D3B",
    "statusBar.noFolderForeground": "#FFFCFD"
  },
  "cSpell.words": [
    "Darkvision",
    "Greatsword",
    "Multiattack",
    "Spellcaster",
    "Spellcasters",
    "Spellcasting"
  ]
}
