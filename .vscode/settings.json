{
  "json.schemaDownload.enable": true,
  "json.schemas": [
    {
      "fileMatch": [
        "src/**/*.json"
      ],
      "url": "./schema/homebrew.schema.json"
    },
  ],
  "workbench.colorCustomizations": {
    "activityBar.background": "#1B107F",
    "titleBar.activeBackground": "#2616B2",
    "titleBar.activeForeground": "#FCFBFF",
    "titleBar.inactiveBackground": "#1B107F",
    "titleBar.inactiveForeground": "#FCFBFF",
    "statusBar.background": "#1B107F",
    "statusBar.foreground": "#FCFBFF",
    "statusBar.debuggingBackground": "#1B107F",
    "statusBar.debuggingForeground": "#FCFBFF",
    "statusBar.noFolderBackground": "#1B107F",
    "statusBar.noFolderForeground": "#FCFBFF"
  }
}
